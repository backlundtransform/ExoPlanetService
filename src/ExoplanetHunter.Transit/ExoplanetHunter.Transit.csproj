<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet packages, not the submodule: this project is used only by the offline Transit CLI,
       never by the API, so the two CSharpNumerics builds never meet in one process. -->
  <ItemGroup>
    <PackageReference Include="CSharpNumerics" Version="4.5.0-preview.1" />
    <!-- 1.0.4: standard transit SNR, refined BLS period, masked multi-planet search, TransitCandidate.Validation.
         1.1.0: BLS trial periods evenly spaced in frequency (finds ultra-short periods); needs core 4.4.0.
         1.2.0: views, vetting features, time-window detrending, injection (used by the vetting dataset).
         1.3.0-preview.1: CandidateVetter (random forest on the vetting features); needs core 4.5.0-preview.1. -->
    <PackageReference Include="CSharpNumerics.Engines" Version="1.3.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExoplanetHunter.Domain\ExoplanetHunter.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExoplanetHunter.Transit.Tests" />
  </ItemGroup>

</Project>
