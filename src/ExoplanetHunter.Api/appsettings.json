{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "Path": "Data/catalog.json.gz",
    "Refresh": {
      "Enabled": false,
      "Interval": "7.00:00:00",
      "StoragePath": "",
      "MinimumPlanetRatio": 0.95
    }
  },
  "Transit": {
    "Refresh": {
      "Enabled": false,
      "Interval": "1.00:00:00",
      "SourceUrl": "https://raw.githubusercontent.com/backlundtransform/ExoPlanetService/master/data/transit/",
      "StoragePath": ""
    }
  },
  "RateLimiting": {
    "PermitsPerMinute": 1200
  }
}
